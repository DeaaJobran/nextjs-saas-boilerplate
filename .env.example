# MOBILE_DEEP_LINK_SECRET=replace-with-a-dedicated-production-secret
SERVER_ACTION_ALLOWED_ORIGINS=localhost:3000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
SECURITY_CONTACT_RATE_LIMIT_MAX=5
SECURITY_MFA_ENFORCED_ROLES=owner,admin
# SECURITY_CSP_CONNECT_SRC=https://api.example.com
# SECURITY_CSP_IMAGE_SRC=https://cdn.example.com
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
