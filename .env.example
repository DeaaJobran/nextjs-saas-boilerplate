NEXT_PUBLIC_APP_URL=http://localhost:3000
OTEL_SERVICE_NAME=nextjs-saas-web
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SDK_DISABLED=false
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_UPTIME_INTERVAL_SECONDS=60
OBSERVABILITY_UPTIME_TIMEOUT_MS=10000
AUTH_SECRET=replace-with-a-random-32-byte-minimum-secret
AUTH_ALLOW_ADMIN_BYPASS=false
