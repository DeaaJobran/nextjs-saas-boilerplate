{
  "name": "@nextjs-saas/db",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./conventions": "./src/conventions.ts",
    "./content": "./src/content-repository.ts",
    "./query": "./src/query-helpers.ts",
    "./reset": "./src/reset.ts",
    "./schema": "./src/schema.ts",
    "./transactions": "./src/transactions.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "reset": "tsx src/scripts/reset.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run --root ../.. packages/db/src",
    "typecheck": "tsc6 --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@nextjs-saas/config": "workspace:*",
    "@nextjs-saas/localization": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  }
}
